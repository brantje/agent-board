# Agent Board control-plane base URL. The runner connects outbound to /api/runner/ws.
AGENT_BOARD_URL=https://agent-board.example.com

# Returned when the external Runner is created in Agent Board.
AGENT_RUNNER_ID=<runner-id>
AGENT_RUNNER_TOKEN=<runner-token>

# Optional. Defaults to /var/lib/agent-runner/workspaces.
AGENT_RUNNER_WORKSPACE_ROOT=/var/lib/agent-runner/workspaces
