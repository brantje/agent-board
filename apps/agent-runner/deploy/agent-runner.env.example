# `agent-runner register` writes the active external Runner configuration to
# /etc/agent-board/agent-runner.env. AGENT_RUNNER_TOKEN is always the permanent
# post-registration Runner credential; the one-time registration token is never
# persisted here.
#
# AGENT_BOARD_URL=https://agent-board.example.com
# AGENT_RUNNER_ID=<runner uuid>
# AGENT_RUNNER_TOKEN=<permanent runner token>

# Optional. Defaults to /var/lib/agent-runner/workspaces.
AGENT_RUNNER_WORKSPACE_ROOT=/var/lib/agent-runner/workspaces
