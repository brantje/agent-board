# Local-development overrides only. Do not place production secrets in this file.
POSTGRES_DB=agent_board
POSTGRES_USER=agent_board
AGENT_BOARD_SERVER_PORT=3001
AGENT_BOARD_WEB_PORT=3000
AGENT_BOARD_WORKSPACE_ROOT=/var/lib/agent-board/workspaces
# Compose bind-mount source and its backend-visible destination.
AGENT_BOARD_REPOSITORY_ROOT=.
AGENT_BOARD_REPOSITORY_MOUNT_PATH=/repositories
# Server-side allowlist. Use the backend-visible paths, separated by the OS path-list separator.
AGENT_BOARD_REPOSITORY_ROOTS=/repositories
AGENT_BOARD_DOCKER_SOCKET=/var/run/docker.sock
