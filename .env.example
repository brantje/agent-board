# Local-development overrides only. Do not place production secrets in this file.
POSTGRES_DB=agent_board
POSTGRES_USER=agent_board
AGENT_BOARD_SERVER_PORT=3001
AGENT_BOARD_WEB_PORT=3000
AGENT_BOARD_WORKSPACE_ROOT=/var/lib/agent-board/workspaces
AGENT_BOARD_EVIDENCE_ROOT=/var/lib/agent-board/evidence
# Optional stable/explicit scheduler worker identity; defaults to hostname:pid.
# AGENT_BOARD_SCHEDULER_OWNER_ID=agent-board-server-1
# Runner reconnect grace. Defaults to 5m; accepts Go duration syntax and must be positive.
# AGENT_BOARD_RUNNER_RECONNECT_TIMEOUT=5m
# Compose bind-mount source and its backend-visible destination. The mount is writable so Agent Board can create missing Project repositories.
AGENT_BOARD_REPOSITORY_ROOT=.
AGENT_BOARD_REPOSITORY_MOUNT_PATH=/repositories
# Compose derives AGENT_BOARD_REPOSITORY_ROOTS from AGENT_BOARD_REPOSITORY_MOUNT_PATH.
AGENT_BOARD_DOCKER_SOCKET=/var/run/docker.sock
# Host docker group GID so the server container can provision Runtime Instances.
# Linux: stat -c '%g' /var/run/docker.sock
AGENT_BOARD_DOCKER_GID=
# Optional overrides for encrypted Provider credential storage.
# Compose generates and persists both values automatically on first startup.
# AGENT_BOARD_SECRET_ENCRYPTION_KEY=
# AGENT_BOARD_SECRET_WRITE_TOKEN=
# Optional OpenRouter API key. On first startup, creates a global Provider named
# OpenRouter when one does not already exist. If the provider exists without a
# stored credential, startup completes that missing credential step. Changing this
# value does not rotate an existing credential; use Settings → Providers instead.
# Recreate the server container after adding or changing env vars so Compose injects them.
# OPENROUTER_API_KEY=
# Optional comma-separated OpenRouter model IDs. When set, the server creates global
# Model Profiles linked to the OpenRouter provider on startup if they do not already
# exist. Profile names use the last path segment of each model ID.
# OPENROUTER_MODELS=anthropic/claude-3.5-sonnet,openai/gpt-4o-mini
# Docker network for Runtime Instances when the server runs in Compose.
AGENT_BOARD_DOCKER_NETWORK=agent-board_default
# UID/GID of the non-root user inside the agent-runner Runtime image. Defaults match
# apps/agent-runner/Dockerfile. Rebuild the Runtime image with AGENT_BOARD_UID when needed.
# AGENT_BOARD_RUNTIME_UID=100
# AGENT_BOARD_RUNTIME_GID=101
